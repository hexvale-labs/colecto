# Maintainer: Kogical <https://github.com/kogical>
# Repackages the prebuilt Linux bundle from the GitHub release. Release CI sets pkgver and
# checksums before pushing this file to the AUR.
pkgname=colecto-bin
pkgver=0.10.0
pkgrel=1
pkgdesc='A fast, native email client (prebuilt Flutter desktop app and Rust daemon)'
arch=('x86_64' 'aarch64')
url='https://github.com/kogical/colecto'
license=('MIT OR Apache-2.0')
depends=('gtk3' 'openssl' 'dbus' 'hicolor-icon-theme')
optdepends=('org.freedesktop.secrets: keep account passwords in the system keyring')
provides=('colecto')
conflicts=('colecto')
options=('!strip' '!debug')
source=("LICENSE-MIT-$pkgver::https://raw.githubusercontent.com/kogical/colecto/v$pkgver/LICENSE-MIT"
        "LICENSE-APACHE-$pkgver::https://raw.githubusercontent.com/kogical/colecto/v$pkgver/LICENSE-APACHE")
source_x86_64=("colecto-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/colecto-v$pkgver-linux-x64.tar.gz")
source_aarch64=("colecto-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/colecto-v$pkgver-linux-arm64.tar.gz")
sha256sums=('SKIP'
            'SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local bundle="colecto-v$pkgver-linux-x64"
  [[ "$CARCH" == "aarch64" ]] && bundle="colecto-v$pkgver-linux-arm64"
  install -dm755 "$pkgdir/usr/lib/colecto" "$pkgdir/usr/bin"
  cp -a "$bundle"/{colecto,data,lib} "$pkgdir/usr/lib/colecto/"
  ln -s /usr/lib/colecto/colecto "$pkgdir/usr/bin/colecto"
  install -Dm755 "$bundle/colecto-daemon" "$bundle/colecto-mcp" -t "$pkgdir/usr/bin/"
  install -Dm644 "$bundle/Colecto.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "LICENSE-MIT-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "LICENSE-APACHE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
