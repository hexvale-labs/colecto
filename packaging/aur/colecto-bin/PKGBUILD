# Maintainer: Hexvale Labs <https://github.com/hexvale-labs>
# Repackages the desktop app from the GitHub release. Release CI sets pkgver and the
# checksums before pushing this file to the AUR.
pkgname=colecto-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='A fast, extensible email client (prebuilt desktop app)'
arch=('x86_64' 'aarch64')
url='https://github.com/hexvale-labs/colecto'
license=('MIT OR Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'openssl' 'dbus' 'hicolor-icon-theme')
optdepends=('org.freedesktop.secrets: keep account passwords in the system keyring')
provides=('colecto')
conflicts=('colecto')
options=('!strip' '!debug')
source=("LICENSE-MIT-$pkgver::https://raw.githubusercontent.com/hexvale-labs/colecto/v$pkgver/LICENSE-MIT"
        "LICENSE-APACHE-$pkgver::https://raw.githubusercontent.com/hexvale-labs/colecto/v$pkgver/LICENSE-APACHE")
source_x86_64=("colecto-$pkgver-x86_64.deb::$url/releases/download/v$pkgver/colecto-v$pkgver-linux-x64.deb")
source_aarch64=("colecto-$pkgver-aarch64.deb::$url/releases/download/v$pkgver/colecto-v$pkgver-linux-arm64.deb")
sha256sums=('SKIP'
            'SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  # makepkg already unpacked the .deb; its data archive holds the installed tree.
  bsdtar -xf data.tar.* -C "$pkgdir"
  # Tauri names the 256 px icon directory after its @2x source; use the standard hicolor name.
  if [[ -d "$pkgdir/usr/share/icons/hicolor/128x128@2" ]]; then
    mv "$pkgdir/usr/share/icons/hicolor/128x128@2" "$pkgdir/usr/share/icons/hicolor/256x256"
  fi
  install -Dm644 "LICENSE-MIT-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "LICENSE-APACHE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
