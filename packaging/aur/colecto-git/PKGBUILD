# Maintainer: Kogical <https://github.com/kogical>
# Builds the latest commit on main. pkgver() derives the version, so this file only
# changes when the build itself changes.
pkgname=colecto-git
pkgver=0.10.0.r0.g0000000
pkgrel=1
pkgdesc='A fast, native email client (development version)'
arch=('x86_64' 'aarch64')
url='https://github.com/kogical/colecto'
license=('MIT OR Apache-2.0')
depends=('gtk3' 'openssl' 'dbus' 'hicolor-icon-theme')
makedepends=('rustup' 'flutter' 'clang' 'cmake' 'ninja' 'git')
optdepends=('org.freedesktop.secrets: keep account passwords in the system keyring')
provides=('colecto')
conflicts=('colecto' 'colecto-bin')
options=('!lto')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local description
  if description=$(git describe --long --tags --abbrev=7 2>/dev/null); then
    printf '%s\n' "$description" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  (cd app && flutter pub get)
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  COLECTO_COMMIT=$(git rev-parse HEAD)
  export COLECTO_COMMIT
  cargo build --frozen --release -p colecto-ffi -p colecto-daemon
  (cd app && flutter build linux --release)
}

package() {
  cd "$pkgname"
  local bundle_dir
  bundle_dir=$(find app/build/linux -type d -name bundle | head -n1)
  install -dm755 "$pkgdir/usr/lib/colecto"
  cp -a "$bundle_dir"/. "$pkgdir/usr/lib/colecto/"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/colecto/colecto "$pkgdir/usr/bin/colecto"
  install -Dm755 target/release/colecto-daemon target/release/colecto-mcp -t "$pkgdir/usr/bin/"

  install -Dm644 packaging/linux/Colecto.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 docs/branding/logo-square.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/colecto.svg"

  for unit in packaging/systemd/*.service; do
    sed 's|/usr/local/bin/|/usr/bin/|' "$unit" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/${unit##*/}"
  done

  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
