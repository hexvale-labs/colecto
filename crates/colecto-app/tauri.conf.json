{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Colecto",
  "mainBinaryName": "colecto",
  "identifier": "app.colecto.mail",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A fast, extensible email client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT OR Apache-2.0",
    "linux": {
      "deb": {
        "desktopTemplate": "../../packaging/linux/Colecto.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "../../packaging/linux/Colecto.desktop.hbs"
      }
    }
  }
}
